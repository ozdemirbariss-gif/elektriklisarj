{
  "rules": {
    ".read": false,
    ".write": false,
    "istasyonlar": {
      ".read": true,
      ".write": false
    },
    "station_status": {
      ".read": true,
      "$stationId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['skor', 'durum', 'etiket', 'arizali', 'sorunsuz', 'aktif_yorum_sayisi', 'son_bildirim_tarihi'])",
        "skor": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "durum": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "etiket": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "arizali": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "sorunsuz": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "aktif_yorum_sayisi": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "son_bildirim_tarihi": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "son_yorumlar": {
          "$idx": {
            "yorum": {
              ".validate": "newData.isString() && newData.val().length <= 160"
            },
            "durum": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "durum_sinifi": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "tarih": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "yorumlar": {
      "$stationId": {
        ".read": "auth != null",
        ".indexOn": ["tarih", "uid"],
        "$commentId": {
          ".write": "auth != null && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['kullanici', 'yorum', 'durum', 'durum_sinifi', 'sinif_kaynagi', 'tarih', 'uid']) && newData.child('uid').val() == auth.uid",
          "kullanici": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "yorum": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "durum": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "durum_sinifi": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "sinif_kaynagi": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "tarih": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() == auth.uid"
          },
          "ek_bilgi": {
            ".validate": true
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "favoriler": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$stationId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "kullanici_yorum_meta": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['son_yorum_zamani'])",
        "son_yorum_zamani": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
